# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local agent state
.yeaah/
.claude/

# research is internal only — except FUTURE.md, the shared roadmap.
# Use a glob inside research/ rather than excluding the directory itself,
# so the negation below can re-include FUTURE.md (Git can't re-include
# files inside a fully-excluded directory).
research/*
!research/FUTURE.md

# mkdocs build output
site/
